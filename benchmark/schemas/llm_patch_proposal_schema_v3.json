{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_tool_id", "drift_category", "location", "openapi_operations", "semantic_extensions", "evidence_refs", "expected_agent_behavior_change", "confidence", "concise_reason"],
  "properties": {
    "target_tool_id": {"type": "string", "minLength": 1},
    "drift_category": {"enum": ["ICD", "RSD", "WPD", "SED"]},
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_id", "layer", "spec_pointer", "runtime_path", "adapter_operation_type"],
      "properties": {
        "tool_id": {"type": "string", "minLength": 1},
        "layer": {"enum": ["input", "response", "workflow", "state_effect"]},
        "spec_pointer": {"type": ["string", "null"], "pattern": "^/"},
        "runtime_path": {"type": ["string", "null"]},
        "adapter_operation_type": {"type": "string", "minLength": 1}
      }
    },
    "openapi_operations": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["op", "path", "value", "evidence_refs", "reason_code"],
        "properties": {
          "op": {"enum": ["add", "remove", "replace", "test"]},
          "path": {"type": "string", "pattern": "^/"},
          "value": {},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "reason_code": {"type": "string", "minLength": 1}
        }
      }
    },
    "semantic_extensions": {"type": "object", "additionalProperties": false, "required": ["x-driftguard-patch-semantics"], "properties": {"x-driftguard-patch-semantics": {"type": "object"}}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "expected_agent_behavior_change": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "concise_reason": {"type": "string", "maxLength": 500}
  }
}
