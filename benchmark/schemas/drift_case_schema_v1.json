{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftguard.local/schemas/drift_case_schema_v1.json",
  "title": "DriftGuard Persistent Drift Cases v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonical_contract_version", "source_openapi", "change_point_default", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonical_contract_version": {"const": "1.0"},
    "source_openapi": {"const": "benchmark/openapi/driftguard_openapi_v1.yaml"},
    "change_point_default": {"type": "integer", "minimum": 1},
    "cases": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "target", "before", "after"],
      "properties": {
        "operation": {
          "enum": [
            "add_required", "rename_input_field", "replace_enum_value",
            "rename_output_field", "map_output_path", "replace_output_path",
            "add_prerequisite", "add_verification_binding", "add_transition_step", "restrict_initial_transition",
            "change_effect_timing", "add_postcondition_verification", "replace_state_effect", "change_resource_identity"
          ]
        },
        "target": {"type": "string", "pattern": "^/"},
        "before": {},
        "after": {}
      }
    },
    "displayedContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "canonical_value"],
      "properties": {
        "source": {"const": "canonical_v1"},
        "target": {"type": "string", "pattern": "^/"},
        "canonical_value": {}
      }
    },
    "symptom": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 2,
      "required": ["kind", "description"],
      "properties": {
        "kind": {"enum": ["http_error", "missing_output", "workflow_failure", "state_mismatch"]},
        "description": {"type": "string", "minLength": 1},
        "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "error_code": {"type": "string", "minLength": 1},
        "message_pattern": {"type": "string", "minLength": 1},
        "field": {"type": ["string", "null"]},
        "retryable": {"type": "boolean"}
      }
    },
    "groundTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "changed_element", "repair_direction"],
      "properties": {
        "location": {"type": "string", "pattern": "^/"},
        "changed_element": {"type": "string", "minLength": 1},
        "repair_direction": {"enum": ["displayed_to_runtime", "runtime_to_canonical"]}
      }
    },
    "validationRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_required", "independent_failures", "regression_tasks_required", "unsafe_write_allowed"],
      "properties": {
        "probe_required": {"const": true},
        "independent_failures": {"type": "integer", "minimum": 2},
        "regression_tasks_required": {"type": "integer", "minimum": 3},
        "unsafe_write_allowed": {"const": false}
      }
    },
    "expectedPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch_type", "target_tool", "operations", "validation_requirements"],
      "properties": {
        "patch_type": {"enum": ["input_contract_patch", "response_mapping_patch", "workflow_precondition_patch", "state_effect_patch"]},
        "target_tool": {"type": "string", "minLength": 1},
        "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mutation"}},
        "validation_requirements": {"$ref": "#/$defs/validationRequirements"}
      }
    },
    "minimumEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_failures", "probe_required", "regression_tasks_required", "same_task_retry_insufficient", "transient_error_codes_excluded"],
      "properties": {
        "independent_failures": {"type": "integer", "minimum": 2},
        "probe_required": {"const": true},
        "regression_tasks_required": {"type": "integer", "minimum": 3},
        "same_task_retry_insufficient": {"const": true},
        "transient_error_codes_excluded": {
          "type": "array", "uniqueItems": true,
          "contains": {"const": "RATE_LIMITED"},
          "minContains": 1,
          "items": {"enum": ["RATE_LIMITED", "SERVICE_UNAVAILABLE", "TIMEOUT"]}
        }
      }
    },
    "affectedTasks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_task_ids", "held_out_required", "control_task_ids"],
      "properties": {
        "canonical_task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[ACF][0-9]{2}$"}},
        "held_out_required": {"type": "boolean"},
        "control_task_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[ACF][0-9]{2}$"}}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drift_id", "drift_type", "target_tool", "summary", "persistence", "change_point", "displayed_contract", "runtime_mutation", "observable_symptom", "ground_truth", "expected_patch", "minimum_evidence", "affected_tasks", "safety_constraints"],
      "properties": {
        "drift_id": {"type": "string", "pattern": "^(ICD|RSD|WPD|SED)-0[1-5]$"},
        "drift_type": {"enum": ["input_contract", "response_shape", "workflow_precondition", "state_effect"]},
        "target_tool": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "persistence": {"const": "persistent"},
        "change_point": {"type": "integer", "minimum": 1},
        "displayed_contract": {"$ref": "#/$defs/displayedContract"},
        "runtime_mutation": {"$ref": "#/$defs/mutation"},
        "observable_symptom": {"$ref": "#/$defs/symptom"},
        "ground_truth": {"$ref": "#/$defs/groundTruth"},
        "expected_patch": {"$ref": "#/$defs/expectedPatch"},
        "minimum_evidence": {"$ref": "#/$defs/minimumEvidence"},
        "affected_tasks": {"$ref": "#/$defs/affectedTasks"},
        "safety_constraints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
