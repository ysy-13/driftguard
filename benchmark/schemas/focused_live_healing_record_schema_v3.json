{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "experiment_kind", "execution_mode", "record_id", "record_status", "provider", "model", "method", "family", "scenario_id", "public_scenario_id", "source_snapshot", "frozen_fingerprints", "stage_trace", "live_evidence_trace", "evidence_provenance", "llm_stage_calls", "llm_calls", "tool_calls", "probe_calls", "patch_proposal_calls", "patch_revision", "deterministic_gates", "immediate_repair", "future_transfer", "termination_reason", "stopped_stage", "infrastructure_or_method_failure", "input_tokens", "output_tokens", "latency_ms", "api_attempts_delta", "cost_cny_delta", "cache", "checkpoint", "leakage", "symbolic_fallback_used", "main_state_pollution", "drift_exposed", "observed_target_tool", "observed_failure_signature", "attribution_evaluable", "pre_drift_agent_failure"],
  "properties": {
    "schema_version": {"const": "focused-live-healing-record-v3"},
    "experiment_kind": {"const": "FOCUSED_LIVE_HEALING_CANARY"},
    "execution_mode": {"enum": ["MOCK_INFRASTRUCTURE_VALIDATION", "CACHE_REPLAY", "REAL_FOCUSED_CANARY", "REAL_PATH_FAKE_PROVIDER_VALIDATION", "REAL_CACHE_REPLAY"]},
    "record_id": {"type": "string"},
    "record_status": {"enum": ["COMPLETE", "INCOMPLETE"]},
    "provider": {"enum": ["deepseek", "dashscope"]},
    "model": {"enum": ["deepseek-v4-flash", "qwen3.7-plus"]},
    "method": {"const": "driftguard_llm"},
    "family": {"enum": ["M01", "M06", "M11", "M16"]},
    "scenario_id": {"enum": ["M01-PD", "M06-PD", "M11-PD", "M16-PD"]},
    "public_scenario_id": {"type": "string", "pattern": "^public-"},
    "source_snapshot": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frozen_fingerprints": {"type": "object"},
    "stage_trace": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"type": "object", "required": ["ordinal", "stage", "status"]}},
    "live_evidence_trace": {"type": "object"},
    "evidence_provenance": {"type": "object"},
    "llm_stage_calls": {"type": "array"},
    "llm_calls": {"type": "integer", "minimum": 0},
    "tool_calls": {"type": "integer", "minimum": 0},
    "probe_calls": {"type": "integer", "minimum": 0},
    "patch_proposal_calls": {"type": "integer", "minimum": 0},
    "patch_revision": {"type": ["object", "null"]},
    "deterministic_gates": {"type": "object"},
    "immediate_repair": {"type": ["object", "null"]},
    "future_transfer": {"type": ["object", "null"]},
    "termination_reason": {"type": "string"},
    "stopped_stage": {"type": "string"},
    "infrastructure_or_method_failure": {"enum": ["NONE", "METHOD_FAILURE", "INFRASTRUCTURE_ERROR"]},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "latency_ms": {"type": "number", "minimum": 0},
    "api_attempts_delta": {"type": "integer", "minimum": 0},
    "actual_network_attempts": {"type": "integer", "minimum": 0},
    "provider_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "status_code", "provider_error_code", "sanitized_message", "request_id", "retryable", "attempt_number", "actual_network_attempts", "failure_layer"],
        "properties": {
          "category": {"enum": ["PROVIDER_ERROR", "PROVIDER_TIMEOUT", "RATE_LIMITED"]},
          "status_code": {"type": ["integer", "null"]},
          "provider_error_code": {"type": ["string", "null"]},
          "sanitized_message": {"type": "string", "maxLength": 512},
          "request_id": {"type": ["string", "null"], "maxLength": 128},
          "retryable": {"type": "boolean"},
          "attempt_number": {"type": "integer", "minimum": 0},
          "actual_network_attempts": {"type": "integer", "minimum": 0},
          "failure_layer": {"enum": ["DNS", "CONNECTION", "TLS", "TIMEOUT", "HTTP", "RESPONSE_PARSE", "UNKNOWN"]}
        }
      }
    },
    "cost_cny_delta": {"type": "number", "minimum": 0},
    "cache": {"type": "object"},
    "checkpoint": {"type": "object"},
    "leakage": {"type": "object"},
    "symbolic_fallback_used": {"const": false},
    "main_state_pollution": {"const": false},
    "drift_exposed": {"type": "boolean"},
    "observed_target_tool": {"type": ["string", "null"]},
    "observed_failure_signature": {"type": ["object", "null"]},
    "attribution_evaluable": {"type": "boolean"},
    "pre_drift_agent_failure": {"type": "boolean"}
  }
}
