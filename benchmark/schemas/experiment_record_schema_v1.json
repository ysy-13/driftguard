{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["experiment_id", "public_scenario_id", "mode", "method", "model", "repetition", "final_task_success", "predicted_class", "localization", "target_tool_correct", "drift_category_correct", "exact_location_correct", "patch_proposed", "patch_accepted", "raw_patch_correct", "accepted_patch_correct", "regression_pass", "minimality_pass", "unsafe_patch", "immediate_repair", "future_transfer", "false_patch", "unsafe_action", "forbidden_side_effects", "llm_calls", "tool_calls", "probe_calls", "input_tokens", "output_tokens", "latency_ms", "termination_reason", "error_category", "prompt_hash", "trace_references", "mock_provider"],
  "properties": {
    "experiment_id": {"type": "string"},
    "public_scenario_id": {"type": "string", "pattern": "^public-"},
    "mode": {"enum": ["component", "end_to_end"]},
    "method": {"type": "string"},
    "model": {"type": "string"},
    "repetition": {"type": "integer", "minimum": 0},
    "final_task_success": {"type": "boolean"},
    "predicted_class": {"type": ["string", "null"]},
    "localization": {"type": ["object", "null"]},
    "target_tool_correct": {"type": ["boolean", "null"]},
    "drift_category_correct": {"type": ["boolean", "null"]},
    "exact_location_correct": {"type": ["boolean", "null"]},
    "patch_proposed": {"type": "boolean"},
    "patch_accepted": {"type": "boolean"},
    "raw_patch_correct": {"type": ["boolean", "null"]},
    "accepted_patch_correct": {"type": ["boolean", "null"]},
    "regression_pass": {"type": ["boolean", "null"]},
    "minimality_pass": {"type": ["boolean", "null"]},
    "unsafe_patch": {"type": "boolean"},
    "immediate_repair": {"type": ["boolean", "null"]},
    "future_transfer": {"type": ["boolean", "null"]},
    "false_patch": {"type": "boolean"},
    "unsafe_action": {"type": "boolean"},
    "forbidden_side_effects": {"type": "integer", "minimum": 0},
    "llm_calls": {"type": "integer", "minimum": 0},
    "tool_calls": {"type": "integer", "minimum": 0},
    "probe_calls": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "latency_ms": {"type": "number", "minimum": 0},
    "termination_reason": {"type": "string"},
    "error_category": {"type": ["string", "null"]},
    "prompt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "catalog_fingerprint": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
    "trace_references": {"type": "array", "items": {"type": "string"}},
    "mock_provider": {"type": "boolean"}
  },
  "additionalProperties": false
}
