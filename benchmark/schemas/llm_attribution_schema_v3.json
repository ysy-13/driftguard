{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["predicted_class", "target_tool_id", "drift_category", "location", "evidence_refs", "requested_probe", "confidence", "concise_reason"],
  "properties": {
    "predicted_class": {"enum": ["AGENT_ERROR", "TRANSIENT_FAILURE", "PERSISTENT_DRIFT", "INSUFFICIENT_EVIDENCE"]},
    "target_tool_id": {"type": ["string", "null"]},
    "drift_category": {"enum": ["ICD", "RSD", "WPD", "SED", "UNKNOWN"]},
    "location": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["tool_id", "layer", "spec_pointer", "runtime_path", "adapter_operation_type"],
      "properties": {
        "tool_id": {"type": "string", "minLength": 1},
        "layer": {"enum": ["input", "response", "workflow", "state_effect"]},
        "spec_pointer": {"type": ["string", "null"], "pattern": "^/"},
        "runtime_path": {"type": ["string", "null"]},
        "adapter_operation_type": {"type": "string", "minLength": 1}
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requested_probe": {"type": ["object", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "concise_reason": {"type": "string", "maxLength": 500}
  }
}
