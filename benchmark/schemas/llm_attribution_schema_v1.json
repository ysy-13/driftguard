{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["predicted_class", "target_tool_id", "drift_category", "location_type", "location_path", "evidence_refs", "requested_probe", "confidence", "concise_reason"],
  "properties": {
    "predicted_class": {"enum": ["AGENT_ERROR", "TRANSIENT_FAILURE", "PERSISTENT_DRIFT", "INSUFFICIENT_EVIDENCE"]},
    "target_tool_id": {"type": ["string", "null"]},
    "drift_category": {"enum": ["ICD", "RSD", "WPD", "SED", "UNKNOWN"]},
    "location_type": {"type": "string"},
    "location_path": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "requested_probe": {"type": ["object", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "concise_reason": {"type": "string", "maxLength": 500}
  },
  "additionalProperties": false
}
