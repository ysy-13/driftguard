{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "git_commit", "source_snapshot", "config_hash", "prompt_sha256", "output_schema_sha256", "evidence_view_definition_sha256", "tool_registry_sha256", "tool_registry", "plan", "heldout48_overlap", "ledger_before", "ledger_before_sha256", "provider_order", "cache_namespaces", "result_namespace"],
  "properties": {
    "schema_version": {"const": "specdriftbench-component-manifest-v1"},
    "attempt_id": {"type": "string"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_snapshot": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_view_definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool_registry": {"type": "object"},
    "plan": {"type": "array", "minItems": 36, "maxItems": 36},
    "heldout48_overlap": {"const": 0},
    "ledger_before": {"type": "object"},
    "ledger_before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_order": {"const": ["deepseek", "dashscope", "moonshot"]},
    "cache_namespaces": {"type": "object"},
    "result_namespace": {"const": "specdriftbench_component_canary_v1"}
  }
}
