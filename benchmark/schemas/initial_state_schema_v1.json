{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftguard.local/schemas/initial_state_schema_v1.json",
  "title": "DriftGuard Initial State v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_id", "schema_version", "canonical_contract_version", "clock", "next_ids", "users", "actors", "repositories"],
  "properties": {
    "fixture_id": {"const": "S0"},
    "schema_version": {"const": "1.0"},
    "canonical_contract_version": {"const": "1.0"},
    "clock": {"type": "string", "format": "date-time"},
    "next_ids": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nextIds"}},
    "users": {"type": "object", "additionalProperties": {"$ref": "#/$defs/user"}},
    "actors": {"type": "object", "additionalProperties": {"$ref": "#/$defs/actor"}},
    "repositories": {"type": "object", "additionalProperties": {"$ref": "#/$defs/repository"}}
  },
  "$defs": {
    "nextIds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "run_id"],
      "properties": {
        "issue_id": {"type": "integer", "minimum": 1},
        "run_id": {"type": "integer", "minimum": 1}
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username", "active"],
      "properties": {
        "username": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9-]+$"},
        "active": {"type": "boolean"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "permissions"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "permissions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "name", "state"],
      "properties": {
        "workflow_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "state": {"enum": ["active", "disabled"]}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "username", "role", "base_permission", "membership_state", "added_at", "updated_at"],
      "properties": {
        "repo_id": {"type": "string", "minLength": 1},
        "username": {"type": "string", "minLength": 1},
        "role": {"enum": ["read", "triage", "write", "maintain", "admin"]},
        "base_permission": {"enum": ["read", "write", "admin"]},
        "membership_state": {"const": "active"},
        "added_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "repo_id", "title", "body", "priority", "state", "assignee", "resolution", "created_at", "updated_at", "closed_at"],
      "properties": {
        "issue_id": {"type": "integer", "minimum": 1},
        "repo_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string"},
        "priority": {"enum": ["low", "medium", "high"]},
        "state": {"enum": ["open", "closed"]},
        "assignee": {"type": ["string", "null"]},
        "resolution": {"type": ["string", "null"], "enum": ["completed", "not_planned", null]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "closed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "pipelineRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "repo_id", "workflow_id", "ref", "status", "conclusion", "attempt", "retried_from", "created_at", "updated_at"],
      "properties": {
        "run_id": {"type": "integer", "minimum": 1},
        "repo_id": {"type": "string", "minLength": 1},
        "workflow_id": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "status": {"enum": ["queued", "in_progress", "completed"]},
        "conclusion": {"type": ["string", "null"], "enum": ["success", "failure", "cancelled", null]},
        "attempt": {"type": "integer", "minimum": 1},
        "retried_from": {"type": ["integer", "null"], "minimum": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "name", "description", "visibility", "default_branch", "issues_enabled", "archived", "branches", "workflows", "members", "issues", "pipeline_runs"],
      "properties": {
        "repo_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "visibility": {"enum": ["public", "private"]},
        "default_branch": {"type": "string", "minLength": 1},
        "issues_enabled": {"type": "boolean"},
        "archived": {"type": "boolean"},
        "branches": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "workflows": {"type": "object", "additionalProperties": {"$ref": "#/$defs/workflow"}},
        "members": {"type": "object", "additionalProperties": {"$ref": "#/$defs/member"}},
        "issues": {"type": "object", "additionalProperties": {"$ref": "#/$defs/issue"}},
        "pipeline_runs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/pipelineRun"}}
      }
    }
  }
}
