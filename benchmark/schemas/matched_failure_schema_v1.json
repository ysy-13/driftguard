{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftguard.local/schemas/matched_failure_schema_v1.json",
  "title": "DriftGuard Matched Failure Triplets v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonical_contract_version", "drift_case_version", "protocol_version", "families"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonical_contract_version": {"const": "1.0"},
    "drift_case_version": {"const": "1.0"},
    "protocol_version": {"const": "1.0"},
    "families": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "#/$defs/family"}}
  },
  "$defs": {
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["channel", "http_status", "error_code", "message_pattern", "response_success"],
      "properties": {
        "channel": {"enum": ["response_error", "missing_output_field", "workflow_rejection", "state_mismatch"]},
        "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "error_code": {"type": ["string", "null"]},
        "field": {"type": ["string", "null"]},
        "message_pattern": {"type": "string", "minLength": 1},
        "response_success": {"type": "boolean"},
        "expected_effect": {"type": "string"},
        "observed_effect": {"type": "string"}
      }
    },
    "agentVisible": {
      "type": "object", "additionalProperties": false,
      "required": ["displayed_spec_source", "evidence_channels", "forbidden_fields", "evidence_bundle"],
      "properties": {
        "displayed_spec_source": {"type": "string", "minLength": 1},
        "evidence_channels": {"type": "array", "uniqueItems": true, "items": {"enum": ["user_task", "displayed_spec", "generated_call", "runtime_response", "state_diff", "recent_history", "candidate_probe_result"]}},
        "forbidden_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_bundle": {"$ref": "evidence_bundle_schema_v1.json"}
      }
    },
    "alignment": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "displayed_spec_source", "runtime_contract_source", "displayed_mutation_ref", "runtime_mutation_ref", "contracts_equal", "change_point", "persistent"],
      "properties": {
        "mode": {"enum": ["aligned_new", "aligned_canonical", "displayed_old_runtime_new"]},
        "displayed_spec_source": {"type": "string", "minLength": 1},
        "runtime_contract_source": {"type": "string", "minLength": 1},
        "displayed_mutation_ref": {"type": ["string", "null"]},
        "runtime_mutation_ref": {"type": ["string", "null"]},
        "contracts_equal": {"type": "boolean"},
        "change_point": {"type": ["integer", "null"], "minimum": 1},
        "persistent": {"type": "boolean"}
      }
    },
    "injection": {
      "type": "object", "additionalProperties": false,
      "required": ["fault_layer", "scope", "active_episodes", "persistent", "description", "same_request_retry_counts_as_independent", "confirmation_excludes"],
      "properties": {
        "fault_layer": {"enum": ["agent_behavior", "runtime_once", "runtime_contract"]},
        "scope": {"enum": ["single_episode", "persistent_from_change_point"]},
        "active_episodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 6}},
        "persistent": {"type": "boolean"},
        "description": {"type": "string", "minLength": 1},
        "same_request_retry_counts_as_independent": {"const": false},
        "confirmation_excludes": {"type": "array", "uniqueItems": true, "items": {"enum": ["RATE_LIMITED", "SERVICE_UNAVAILABLE", "TIMEOUT"]}}
      }
    },
    "episode": {
      "type": "object", "additionalProperties": false,
      "required": ["episode_id", "index", "phase", "task_instance_ref", "task_instance_kind", "agent_fault_active", "runtime_fault_active", "runtime_drift_active", "candidate_patch_active", "patch_evidence", "expected_observation_ref", "visible_to_diagnoser"],
      "properties": {
        "episode_id": {"type": "string", "pattern": "^M(0[1-9]|1[0-9]|20)-(AE|TF|PD)-E[1-6]$"},
        "index": {"type": "integer", "minimum": 1, "maximum": 6},
        "phase": {"enum": ["baseline", "first_failure", "replication_or_recovery", "probe_or_confirmation", "held_out_transfer"]},
        "task_instance_ref": {"type": "string", "minLength": 1},
        "task_instance_kind": {"enum": ["regression", "detection", "probe", "future_transfer"]},
        "agent_fault_active": {"type": "boolean"},
        "runtime_fault_active": {"type": "boolean"},
        "runtime_drift_active": {"type": "boolean"},
        "candidate_patch_active": {"type": "boolean"},
        "patch_evidence": {"type": "boolean"},
        "expected_observation_ref": {"type": "string", "minLength": 1},
        "visible_to_diagnoser": {"type": "boolean"}
      }
    },
    "evaluatorMetadata": {
      "type": "object", "additionalProperties": false,
      "required": ["ground_truth_label", "source_drift_id", "expected_action", "persistent_patch_allowed", "false_patch_if_patched", "expected_patch_ref", "independent_failure_instance_refs", "probe_episode_id", "regression_task_refs", "future_transfer_instance_ref", "unsafe_write_allowed", "same_request_retry_counts_as_independent", "transient_confirmation_codes_excluded"],
      "properties": {
        "ground_truth_label": {"enum": ["agent_error", "transient_failure", "persistent_drift"]},
        "source_drift_id": {"type": "string", "pattern": "^(ICD|RSD|WPD|SED)-0[1-5]$"},
        "expected_action": {"enum": ["repair_current_call", "retry_or_recover_without_patch", "propose_validate_and_activate_patch"]},
        "persistent_patch_allowed": {"type": "boolean"},
        "false_patch_if_patched": {"type": "boolean"},
        "expected_patch_ref": {"type": ["string", "null"]},
        "independent_failure_instance_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "probe_episode_id": {"type": ["string", "null"]},
        "regression_task_refs": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[ACF][0-9]{2}$"}},
        "future_transfer_instance_ref": {"type": "string", "minLength": 1},
        "unsafe_write_allowed": {"const": false},
        "same_request_retry_counts_as_independent": {"const": false},
        "transient_confirmation_codes_excluded": {"type": "array", "uniqueItems": true, "items": {"enum": ["RATE_LIMITED", "SERVICE_UNAVAILABLE", "TIMEOUT"]}}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "variant_code", "agent_visible", "contract_alignment", "injection", "episode_schedule", "evaluator_metadata"],
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^M(0[1-9]|1[0-9]|20)-(AE|TF|PD)$"},
        "variant_code": {"enum": ["AE", "TF", "PD"]},
        "agent_visible": {"$ref": "#/$defs/agentVisible"},
        "contract_alignment": {"$ref": "#/$defs/alignment"},
        "injection": {"$ref": "#/$defs/injection"},
        "episode_schedule": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/episode"}},
        "evaluator_metadata": {"$ref": "#/$defs/evaluatorMetadata"}
      }
    },
    "family": {
      "type": "object", "additionalProperties": false,
      "required": ["matched_case_id", "source_drift_id", "target_tool", "shared_observation_signature", "scenarios"],
      "properties": {
        "matched_case_id": {"type": "string", "pattern": "^M(0[1-9]|1[0-9]|20)$"},
        "source_drift_id": {"type": "string", "pattern": "^(ICD|RSD|WPD|SED)-0[1-5]$"},
        "target_tool": {"type": "string", "minLength": 1},
        "shared_observation_signature": {"$ref": "#/$defs/signature"},
        "scenarios": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/scenario"}}
      }
    }
  }
}
